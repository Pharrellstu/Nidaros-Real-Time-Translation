# Application Settings
ASPNETCORE_ENV=Development

# Stream URLs - Update these with your actual stream URLs
RTMP_STREAM_URL=rtmp://your-rtmp-server:1935/stream/key
HLS_STREAM_URL=http://your-hls-server:1935/stream/playlist.m3u8

# Wowza Streaming Engine
WSE_LICENSE_KEY=your-license-key
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
